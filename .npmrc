# Force a flat, hoisted node_modules instead of pnpm's default nested
# `.pnpm` virtual store. This exists specifically because Prisma's
# generated query-engine binary (`.prisma/client/libquery_engine-*.so.node`)
# ends up buried several directories deep inside the `.pnpm` store by
# default (e.g. `node_modules/.pnpm/@prisma+client@<hash>/node_modules/.prisma/client`),
# and Vercel's serverless packaging for this app was confirmed NOT to
# reliably include that nested file even when Next.js's own local build
# trace (.next/server/**/*.nft.json) said it would — see docs/deployment.md.
# With hoisting, `@prisma/client` (and the `.prisma/client` folder Prisma
# generates next to it) lands at the plain `node_modules/.prisma/client`,
# the well-supported layout every Prisma+Vercel guide assumes and that
# needs no custom output-file-tracing configuration to work.
node-linker=hoisted
