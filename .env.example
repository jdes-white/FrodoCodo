# Copy to .env and fill in for local development.
# Never commit real household financial data or real secrets to this repo.

# --- Database ---
# The app's runtime queries use this. In production (Render), point it at
# Neon's pooled (PgBouncer) connection string.
DATABASE_URL="postgresql://frodocodo:frodocodo@localhost:5432/frodocodo?schema=public"
# `prisma migrate` commands use this instead — Prisma's own directUrl
# support (see packages/db/prisma/schema.prisma), since PgBouncer's
# transaction pooling mode doesn't support the advisory locks migrations
# need. In production, point this at Neon's direct (non-pooled) connection
# string. Locally there's no pooling proxy, so it's the same value.
DIRECT_URL="postgresql://frodocodo:frodocodo@localhost:5432/frodocodo?schema=public"

# --- Auth ---
# Signs the session cookie (apps/web/lib/session.ts). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Financial data provider ---
# "mock" uses synthetic CBA/Virgin Money/Amex-shaped data and requires no credentials.
# "basiq" is the real CDR-accredited aggregator adapter, implemented for CBA and Virgin
# only (see docs/basiq-integration.md) — NOT connected to any live account or CDR consent
# by this repo. Set these only when you have your own Basiq account, have reviewed
# docs/basiq-integration.md's unresolved pre-live items, and are deliberately starting a
# real connection (never as a side effect of running this repo).
FINANCIAL_PROVIDER="mock"
BASIQ_API_KEY=""

# --- Runtime LLM (Anthropic) ---
# The AI coach runs against a deterministic template stub (AI_PROVIDER=stub) by default,
# so the app is fully usable with no LLM credentials. Set AI_PROVIDER=anthropic and provide
# a key to enable the real Claude-backed FinancialIntelligenceService.
AI_PROVIDER="stub"
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-5 (see packages/ai/src/anthropicGateway.ts) if unset.
ANTHROPIC_MODEL=""

# --- App-level secret encryption (packages/db/src/payloadEncryption.ts) ---
# AES-256-GCM key protecting anything this app encrypts before writing it to
# the database — today, a real provider connection's access/refresh token
# (FinancialConnection.accessTokenEncrypted/refreshTokenEncrypted, see
# packages/db/src/connectionTokenStorage.ts and docs/basiq-integration.md).
# Base64-encoded, must decode to exactly 32 bytes. Generate with:
# openssl rand -base64 32
# Optional outside production: without it, nothing is stored (never as
# plaintext) rather than encrypted. Required once NODE_ENV=production —
# encryptForStorage() throws rather than persisting a real secret unencrypted.
APP_ENCRYPTION_KEY=""

# --- Worker ---
WORKER_SYNC_INTERVAL_MINUTES="60"

# --- Demo seeding (apps/web/app/api/admin/seed) ---
# Required to call POST /api/admin/seed, which (re-)populates the household
# with synthetic demo data — see packages/db/src/seedHousehold.ts. This is
# a low-sensitivity operational secret (not a database credential): it only
# gates who can trigger a reset of the demo data. Generate with:
# openssl rand -base64 24
SEED_TOKEN=""
