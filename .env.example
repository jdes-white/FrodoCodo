# Copy to .env and fill in for local development.
# Never commit real household financial data or real secrets to this repo.

# --- Database ---
DATABASE_URL="postgresql://frodocodo:frodocodo@localhost:5432/frodocodo?schema=public"

# --- Auth ---
# Signs the session cookie (apps/web/lib/session.ts). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Financial data provider ---
# "mock" uses synthetic CBA/Virgin Money/Amex-shaped data and requires no credentials.
# "basiq" is the real CDR-accredited aggregator adapter (see docs/provider-integration.md)
# and is not wired to live credentials in this repo — set these only when you have your
# own Basiq account and have reviewed docs/provider-integration.md.
FINANCIAL_PROVIDER="mock"
BASIQ_API_KEY=""

# --- Runtime LLM (Anthropic) ---
# The AI coach runs against a deterministic template stub (AI_PROVIDER=stub) by default,
# so the app is fully usable with no LLM credentials. Set AI_PROVIDER=anthropic and provide
# a key to enable the real Claude-backed FinancialIntelligenceService.
AI_PROVIDER="stub"
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-5 (see packages/ai/src/anthropicGateway.ts) if unset.
ANTHROPIC_MODEL=""

# --- Worker ---
WORKER_SYNC_INTERVAL_MINUTES="60"

# --- Demo seeding (apps/web/app/api/admin/seed) ---
# Required to call POST /api/admin/seed, which (re-)populates the household
# with synthetic demo data — see packages/db/src/seedHousehold.ts. This is
# a low-sensitivity operational secret (not a database credential): it only
# gates who can trigger a reset of the demo data. Generate with:
# openssl rand -base64 24
SEED_TOKEN=""
