// FrodoCodo — Household Financial Operating System
// Domain model per project spec §36. Money is always Decimal — never Float.

// Standard Prisma Client with its native query-engine binary — the
// well-trodden default. FrodoCodo previously ran on Vercel's serverless
// platform, where getting this native binary correctly packaged into a
// deployed function proved unreliable (multiple attempts, each verified
// locally, each failing in production — see git history / docs/deployment.md
// for anyone curious). That's a Vercel-serverless-packaging problem, not a
// problem with the native engine itself: in a normal Docker/Linux
// container (see Dockerfile), we control the whole filesystem directly —
// there's no function-packaging step for a binary to go missing from, so
// there's no reason to prefer the more complex driver-adapter setup
// (@prisma/adapter-pg + pg) that was built specifically to route around
// that problem. `binaryTargets` names the runtime platform explicitly:
// "native" covers local dev on whatever OS you're running, and
// "debian-openssl-3.0.x" covers the Dockerfile's node:22-bookworm-slim
// base image.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // The app's runtime queries use this — set it to Neon's pooled (PgBouncer)
  // connection string for a long-lived service like Render's, so many
  // concurrent requests share a small number of backend connections.
  url       = env("DATABASE_URL")
  // `prisma migrate deploy` (and `migrate dev`, `db push`) use this instead
  // of `url` whenever it's set — Prisma's own first-class support for
  // exactly the pooled/direct split Neon requires (PgBouncer's transaction
  // pooling mode doesn't support the advisory locks migrations need). Point
  // this at Neon's direct (non-pooled) connection string. This replaced a
  // hand-rolled multi-env-var-name resolver that existed only to guess
  // which of several names Vercel's Neon integration used — Render just
  // gets both env vars set explicitly and directly.
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum HouseholdRole {
  ADMIN
  MEMBER
}

enum AccountType {
  TRANSACTION
  CREDIT_CARD
  SAVINGS
  OTHER
}

enum ConnectionMethod {
  CDR
  CREDENTIAL_BASED
  MANUAL
}

enum ConsentStatus {
  PENDING
  ACTIVE
  EXPIRING
  EXPIRED
  REVOKED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  INITIAL_IMPORT
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  POSTED
}

enum ClassificationSource {
  RULE
  LEARNED_MAPPING
  PROVIDER
  AI
  USER
  SYSTEM
}

enum SpendingType {
  FIXED_COMMITMENT
  FLEXIBLE
  SAVINGS
}

enum BudgetPeriodType {
  CALENDAR_MONTH
  ANCHORED_MONTHLY
  FORTNIGHTLY
  CUSTOM
}

enum BudgetPeriodStatus {
  ACTIVE
  CLOSED
  FUTURE
}

enum InsightType {
  PACING
  PROJECTED_OVERSPEND
  UNUSUAL_CATEGORY_INCREASE
  UNUSUAL_MERCHANT_INCREASE
  SPENDING_SPIKE
  RECURRING_DETECTED
  SUBSCRIPTION_DETECTED
  DUPLICATE_LOOKING_CHARGE
  UNUSUALLY_LARGE_TRANSACTION
  CATEGORY_TREND
  DISCRETIONARY_TREND
  INCOME_CHANGE
  FIXED_COST_CHANGE
  FORGOTTEN_SUBSCRIPTION
  PERIOD_OVER_PERIOD_COMPARISON
}

enum InsightSeverity {
  INFO
  NOTICE
  WARNING
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum NotificationType {
  CATEGORY_APPROACHING_BUDGET
  OVERSPEND_RISK
  UNUSUAL_LARGE_TRANSACTION
  SYNC_FAILURE
  REVIEW_QUEUE_ITEM
  PROJECTED_OUTCOME_DETERIORATION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum IncomeFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  IRREGULAR
}

// A manually-entered commitment's optional repeat cadence (§5 of the
// Upcoming Commitments V1 spec) — deliberately just these three, matching
// IncomeFrequency's cadence vocabulary minus IRREGULAR (a commitment either
// repeats on a fixed cadence or it doesn't; there's no "irregular
// commitment" concept). Null on UpcomingCommitment.recurrence means
// one-off, not "unset".
enum CommitmentRecurrence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// ---------- Household & users ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     HouseholdMember[]
  auditEvents     AuditEvent[]
  aiConversations AIConversation[]
  aiMessages      AIMessage[]
  notificationPreferences NotificationPreference[]
  classifications TransactionClassification[]
  merchantRules   MerchantRule[]
  createdCommitments UpcomingCommitment[]
}

model Household {
  id                     String           @id @default(cuid())
  name                   String
  defaultBudgetPeriodType BudgetPeriodType @default(CALENDAR_MONTH)
  budgetAnchorDay        Int?
  timezone               String           @default("Australia/Brisbane")
  onboardingCompletedAt  DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  members            HouseholdMember[]
  institutions       FinancialConnection[]
  categories         Category[]
  buckets            BudgetBucket[]
  budgetPeriods      BudgetPeriod[]
  incomeSources      IncomeSource[]
  fixedCommitments   FixedCommitment[]
  savingsGoals       SavingsGoal[]
  insights           Insight[]
  aiConversations    AIConversation[]
  notificationPrefs  NotificationPreference[]
  auditEvents        AuditEvent[]
  merchants          Merchant[]
  merchantRules      MerchantRule[]
  northStarAssumptions NorthStarAssumptions?
  upcomingCommitments UpcomingCommitment[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

// ---------- Financial institutions & connections ----------

model FinancialInstitution {
  id                       String   @id @default(cuid())
  name                     String
  shortName                String
  country                  String   @default("AU")
  logoUrl                  String?
  supportedConnectionMethod ConnectionMethod
  providerInstitutionId    String
  providerName             String
  createdAt                DateTime @default(now())

  connections FinancialConnection[]

  @@unique([providerName, providerInstitutionId])
}

model FinancialConnection {
  id                   String           @id @default(cuid())
  householdId          String
  institutionId        String
  providerName         String
  providerConnectionId String
  connectionMethod     ConnectionMethod
  consentStatus        ConsentStatus    @default(PENDING)
  consentGrantedAt     DateTime?
  consentExpiresAt     DateTime?
  lastSyncedAt         DateTime?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  household   Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  institution FinancialInstitution  @relation(fields: [institutionId], references: [id])
  accounts    Account[]
  syncRuns    SyncRun[]

  @@index([householdId])
}

model Account {
  id                  String      @id @default(cuid())
  connectionId        String
  providerAccountId   String
  displayName         String
  accountType         AccountType
  currency            String      @default("AUD")
  currentBalance      Decimal?    @db.Decimal(14, 2)
  availableBalance    Decimal?    @db.Decimal(14, 2)
  isIncludedInBudget  Boolean     @default(true)
  lastSyncedAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  connection   FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  fixedCommitments FixedCommitment[]

  @@unique([connectionId, providerAccountId])
}

model SyncRun {
  id                    String      @id @default(cuid())
  connectionId          String
  trigger               SyncTrigger
  status                SyncStatus  @default(PENDING)
  startedAt             DateTime    @default(now())
  completedAt           DateTime?
  accountsSynced        Int         @default(0)
  transactionsImported  Int         @default(0)
  transactionsUpdated   Int         @default(0)
  errorMessage          String?

  connection   FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([connectionId, startedAt])
}

// ---------- Merchants ----------

model Merchant {
  id               String   @id @default(cuid())
  householdId      String
  normalizedName   String
  matchKey         String
  defaultCategoryId String?
  isRecurring      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  defaultCategory Category?     @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  rules           MerchantRule[]

  @@unique([householdId, matchKey])
}

model MerchantRule {
  id           String   @id @default(cuid())
  householdId  String
  merchantId   String
  categoryId   String
  priority     Int      @default(100)
  createdById  String?
  createdAt    DateTime @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation(fields: [createdById], references: [id])

  @@unique([householdId, merchantId])
}

// ---------- Budget hierarchy ----------

model BudgetBucket {
  id          String   @id @default(cuid())
  householdId String
  name        String
  sortOrder   Int      @default(0)
  colorToken  String   @default("neutral")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categories Category[]

  @@unique([householdId, name])
}

model Category {
  id           String       @id @default(cuid())
  householdId  String
  bucketId     String
  name         String
  spendingType SpendingType @default(FLEXIBLE)
  sortOrder    Int          @default(0)
  isArchived   Boolean      @default(false)
  createdAt    DateTime     @default(now())

  household         Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  bucket             BudgetBucket        @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  suggestedForTransactions Transaction[] @relation("SuggestedCategory")
  classifications    TransactionClassification[]
  allocations        BudgetAllocation[]
  merchantDefaults   Merchant[]
  merchantRules      MerchantRule[]
  fixedCommitments   FixedCommitment[]
  savingsGoals       SavingsGoal[]
  upcomingCommitments UpcomingCommitment[]

  @@unique([householdId, name])
  @@index([bucketId])
}

model BudgetPeriod {
  id          String             @id @default(cuid())
  householdId String
  type        BudgetPeriodType
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      BudgetPeriodStatus @default(ACTIVE)
  expectedIncome Decimal         @default(0) @db.Decimal(14, 2)
  bufferAmount   Decimal         @default(0) @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]
  insights    Insight[]

  @@unique([householdId, startDate, endDate])
  @@index([householdId, status])
}

model BudgetAllocation {
  id             String   @id @default(cuid())
  budgetPeriodId String
  categoryId     String
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  budgetPeriod BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetPeriodId, categoryId])
}

model IncomeSource {
  id                String          @id @default(cuid())
  householdId       String
  name              String
  expectedAmount    Decimal         @db.Decimal(14, 2)
  frequency         IncomeFrequency
  nextExpectedDate  DateTime?       @db.Date
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model FixedCommitment {
  id                  String   @id @default(cuid())
  householdId         String
  categoryId          String
  accountId           String?
  name                String
  expectedAmount      Decimal  @db.Decimal(14, 2)
  expectedDueDayOfMonth Int?
  frequency           IncomeFrequency @default(MONTHLY)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model SavingsGoal {
  id           String    @id @default(cuid())
  householdId  String
  categoryId   String?
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime? @db.Date
  currentAmount Decimal  @default(0) @db.Decimal(14, 2)
  priority     Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

// ---------- Upcoming Commitments (manually-tracked known bills, V1) ----------

// A household-maintained forecast item — "we know this bill is coming" —
// deliberately separate from Transaction (something that actually
// happened) and from FixedCommitment (a category-level pacing hint used by
// packages/domain/src/pacing.ts's step-function expected-spend curve).
// This one drives Home's "Coming Up" widget only: how much of what's left
// this budget period is already spoken for by bills the household knows
// about but hasn't paid yet. See apps/web/lib/commitments.ts and
// packages/domain/src/commitments.ts for the read/calculation logic this
// feeds.
model UpcomingCommitment {
  id              String                @id @default(cuid())
  householdId     String
  // Which budget category this bill belongs to — drives the Home Page 2
  // bucket-card integration (apps/web/components/BucketCard.tsx): a
  // commitment rolls up into its category's bucket for the "$420 due in
  // the next 7 days" line. Nullable because commitments predate this field
  // (existing rows have none) and because the household chooses the
  // category explicitly when adding/editing one — this is never inferred
  // from transaction history (see packages/domain/src/commitments.ts).
  // SetNull rather than Cascade: deleting a category shouldn't silently
  // delete the household's record of a bill they still owe.
  categoryId      String?
  name            String
  amount          Decimal               @db.Decimal(14, 2)
  expectedDate    DateTime              @db.Date
  // Null = one-off. Set = "when marked paid, create the next occurrence"
  // (apps/web/app/(app)/commitments/actions.ts) — cheap, manual recurrence
  // per §5 of the spec, not pattern detection from transaction history.
  recurrence      CommitmentRecurrence?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, expectedDate])
  @@index([categoryId])
}

// ---------- Transactions (canonical model, spec §9) ----------

model Transaction {
  id                     String               @id @default(cuid())
  accountId              String
  syncRunId              String?
  providerTransactionId  String?
  institutionTransactionRef String?

  transactionDate  DateTime @db.Date
  postingDate      DateTime? @db.Date
  amount           Decimal  @db.Decimal(14, 2) // always positive magnitude
  direction        TransactionDirection
  status           TransactionStatus @default(POSTED)

  originalDescription String
  normalizedMerchantId String?
  merchantConfidence   Float?

  categoryId             String?
  classificationConfidence Float?
  classificationSource     ClassificationSource?
  isUserOverridden         Boolean @default(false)

  // The deterministic classifier's best guess when nothing cleared the
  // auto-classify confidence threshold (resolveClassification's
  // NEEDS_REVIEW outcome, packages/ledger/src/classification.ts) — kept
  // entirely separate from categoryId/classificationSource above so a
  // transaction carrying a suggestion is still unambiguously
  // uncategorised (categoryId stays null) until a human confirms it. The
  // reclassify UI uses this only to preselect/hint an option; it's never
  // read by budget totals or anything else that treats categoryId as the
  // source of truth. Cleared back to null once the transaction is
  // actually classified (by the user or by a bulk rule application).
  suggestedCategoryId         String?
  suggestedCategorySource     ClassificationSource?
  suggestedCategoryConfidence Float?

  notes String?

  isRecurring         Boolean @default(false)
  isTransfer          Boolean @default(false)
  transferGroupId     String?
  counterpartTransactionId String? @unique

  isExcludedFromBudget Boolean @default(false)

  refundOfTransactionId String?

  rawProviderPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  syncRun          SyncRun?      @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  merchant         Merchant?     @relation(fields: [normalizedMerchantId], references: [id], onDelete: SetNull)
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  suggestedCategory Category?    @relation("SuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  classifications  TransactionClassification[]
  counterpart      Transaction?  @relation("TransferCounterpart", fields: [counterpartTransactionId], references: [id], onDelete: SetNull)
  counterpartOf     Transaction? @relation("TransferCounterpart")
  refundOf         Transaction?  @relation("RefundChain", fields: [refundOfTransactionId], references: [id], onDelete: SetNull)
  refunds          Transaction[] @relation("RefundChain")
  insightEvidence  InsightEvidence[]

  @@unique([accountId, providerTransactionId])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([status])
  @@index([isExcludedFromBudget])
}

model TransactionClassification {
  id             String               @id @default(cuid())
  transactionId  String
  categoryId     String
  source         ClassificationSource
  confidence     Float
  ruleId         String?
  createdByUserId String?
  isCurrent      Boolean              @default(true)
  createdAt      DateTime             @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdByUserId], references: [id])

  @@index([transactionId])
}

// ---------- Insights ----------

model Insight {
  id             String          @id @default(cuid())
  householdId    String
  budgetPeriodId String?
  type           InsightType
  severity       InsightSeverity @default(INFO)
  title          String
  summary        String
  dedupeKey      String
  isDismissed    Boolean         @default(false)
  isRead         Boolean         @default(false)
  generatedAt    DateTime        @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  budgetPeriod BudgetPeriod? @relation(fields: [budgetPeriodId], references: [id], onDelete: SetNull)
  evidence     InsightEvidence[]

  @@unique([householdId, dedupeKey])
  @@index([householdId, generatedAt])
}

model InsightEvidence {
  id            String   @id @default(cuid())
  insightId     String
  label         String
  transactionId String?
  value         Decimal? @db.Decimal(14, 2)
  metadata      Json?

  insight     Insight      @relation(fields: [insightId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
}

// ---------- AI ----------

model AIConversation {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  title       String   @default("New conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
  messages  AIMessage[]
}

model AIMessage {
  id              String        @id @default(cuid())
  conversationId  String
  userId          String?
  role            AIMessageRole
  content         String
  contextSnapshot Json?
  createdAt       DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
}

// ---------- Notifications ----------

model NotificationPreference {
  id          String              @id @default(cuid())
  householdId String
  userId      String
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  isEnabled   Boolean             @default(true)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([householdId, userId, type, channel])
}

// ---------- North Star (long-term financial independence direction) ----------

// A household-level (not per-user) set of editable assumptions driving the
// Employment Dependency model — see packages/domain/src/northStar.ts for
// the actual calculations. One row per household; getOrCreate'd on first
// visit (apps/web/lib/northStar.ts) rather than requiring every household
// to be re-seeded when this table was introduced.
model NorthStarAssumptions {
  id          String @id @default(cuid())
  householdId String @unique

  // "Our life" — today's-dollars annual figures the rest of the model is
  // built from. lifestyleTarget intentionally folds in the mortgage and
  // all lifestyle costs as one number (§1 of the spec) rather than being
  // decomposed — the household updates this periodically as life changes.
  lifestyleTarget  Decimal @db.Decimal(14, 2)
  employmentIncome Decimal @db.Decimal(14, 2) // combined after-tax household employment income

  // "Investments"
  investedAssetsToday       Decimal @db.Decimal(14, 2)
  incomeProducingPortion    Decimal @db.Decimal(6, 4) // 0-1 fraction of invested assets treated as cash-yield-bearing
  cashYield                 Decimal @db.Decimal(6, 4) // 0-1 fraction, annual cash yield on the income-producing portion
  capitalGrowthAssumption   Decimal @db.Decimal(6, 4) // 0-1 fraction, annual capital growth used only for the projection
  reinvestInvestmentIncome  Boolean @default(true)
  plannedAnnualContribution Decimal @db.Decimal(14, 2)

  // "Other engines" — already after-tax and after associated costs (§3)
  sideBusinessIncome Decimal @db.Decimal(14, 2) @default(0)
  otherPassiveIncome Decimal @db.Decimal(14, 2) @default(0)

  // "Direction" — the destination is deliberately editable, not hard-coded
  // (§13); timeHorizonYears only bounds the projection table, it isn't a
  // deadline the model enforces.
  timeHorizonYears           Int     @default(10)
  targetEmploymentDependency Decimal @db.Decimal(5, 2) @default(0) // 0-100, 0 = "work optional"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// ---------- Audit ----------

model AuditEvent {
  id           String   @id @default(cuid())
  householdId  String
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id])

  @@index([householdId, createdAt])
}
